<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Identidad básica ─────────────────────────────────── -->

        <EditText
            android:id="@+id/etEqNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEqMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEqModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Modelo"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEqSerial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Serial"
            android:inputType="text"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEqTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo (Condensadora, Air Handler, …)"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <!-- ── Sección: Especificaciones técnicas ───────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Especificaciones técnicas"
            android:textColor="#9A9A9A"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Scan nameplate button -->
        <Button
            android:id="@+id/btnScanNameplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escanear placa"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EB1700"
            android:layout_marginBottom="10dp" />

        <!-- tons + seer en la misma fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etEqTons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tons"
                android:inputType="numberDecimal"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etEqSeer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="SEER"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- refrigerante -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refrigerante"
            android:textColor="#767676"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinnerRefrigerante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- voltaje -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltaje"
            android:textColor="#767676"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinnerVoltaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- fase -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fase"
            android:textColor="#767676"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinnerFase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- fecha fabricación + ubicación -->
        <EditText
            android:id="@+id/etEqManufactureDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha fabricación (ej. 2019-06)"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEqUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación (ej. Cuarto mecánico, Techo)"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <!-- heat pump -->
        <CheckBox
            android:id="@+id/cbEqHeatPump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heat Pump"
            android:textColor="#191919"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- ── Sección: Topología del sistema ───────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Topología del sistema"
            android:textColor="#9A9A9A"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- systemRole -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rol del equipo"
            android:textColor="#767676"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinnerSystemRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- lifecycleStatus -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado del ciclo de vida"
            android:textColor="#767676"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinnerLifecycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- scanStatus: read-only informativo -->
        <LinearLayout
            android:id="@+id/rowScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Origen de datos"
                android:textColor="#767676"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANUAL"
                android:textColor="#767676"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_chip_unselected" />
        </LinearLayout>

        <!-- ── Notas ─────────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notas"
            android:textColor="#9A9A9A"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEqNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notas técnicas opcionales"
            android:inputType="textMultiLine"
            android:minLines="2" />

    </LinearLayout>
</ScrollView>
