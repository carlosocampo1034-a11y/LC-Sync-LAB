<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Atrás" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_gravity="center_vertical"
            android:text="Estado del Servicio"
            android:textColor="@color/lc_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/lc_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvClienteNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lc_text"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvEstadoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:textColor="@color/lc_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="PENDIENTE" />

                <TextView
                    android:id="@+id/tvTecnicoPublico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/lc_text_secondary"
                    android:text="Técnico asignado" />

            </LinearLayout>

            <!-- Cards section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:background="@color/lc_bg">

                <!-- Service details card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_surface"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DETALLES DEL SERVICIO"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/lc_text_secondary"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvPublicoEquipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="15sp"
                        android:textColor="@color/lc_text"
                        android:text="—" />

                    <TextView
                        android:id="@+id/tvPublicoDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/lc_text_secondary"
                        android:text="—" />

                    <TextView
                        android:id="@+id/tvPublicoHora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/lc_text_secondary"
                        android:text="—" />

                </LinearLayout>

                <!-- Progress card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_surface"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PROGRESO"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/lc_text_secondary"
                        android:letterSpacing="0.04" />

                    <ProgressBar
                        android:id="@+id/progressEstado"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:max="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tvProgresoPct"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="@color/lc_text_secondary"
                            android:text="0%" />

                        <TextView
                            android:id="@+id/tvProgresoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/lc_text_secondary"
                            android:text="Completado" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Share button -->
                <Button
                    android:id="@+id/btnCompartirEstado"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="COMPARTIR ESTADO"
                    android:textColor="@color/lc_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.03"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- Bottom spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
