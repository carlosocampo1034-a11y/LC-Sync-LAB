<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Atrás" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Nuevo Hallazgo"
            android:textColor="@color/lc_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/lc_border" />

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/lc_bg">

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="CANCELAR"
            android:textColor="@color/lc_text_secondary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:text="GUARDAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/divider"
        android:layout_above="@id/bottomBar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Area spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Área *"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerArea"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Component -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Componente / Pieza *"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etComponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="ej. Compresor, Capacitor, Serpentín..."
                android:textColor="@color/lc_text"
                android:textColorHint="@color/lc_text_tertiary"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <!-- Problem -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción del problema *"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="ej. Ruido anormal, no arranca, fuga de refrigerante..."
                android:textColor="@color/lc_text"
                android:textColorHint="@color/lc_text_tertiary"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top" />

            <!-- Diagnosis (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnóstico (opcional)"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="Descripción técnica del diagnóstico..."
                android:textColor="@color/lc_text"
                android:textColorHint="@color/lc_text_tertiary"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top" />

            <!-- Resolution (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolución propuesta (opcional)"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="ej. Reemplazar capacitor, ajustar refrigerante..."
                android:textColor="@color/lc_text"
                android:textColorHint="@color/lc_text_tertiary"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top" />

            <!-- Severity chips row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severidad"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/severityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCritical"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="● CRÍTICO"
                    android:textSize="12sp"
                    android:textColor="@color/lc_text"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="▲ ALTO"
                    android:textSize="12sp"
                    android:textColor="@color/lc_text"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="■ MEDIO"
                    android:textSize="12sp"
                    android:textColor="@color/lc_text"
                    android:background="@drawable/bg_chip_selected" />

                <TextView
                    android:id="@+id/chipLow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="▽ BAJO"
                    android:textSize="12sp"
                    android:textColor="@color/lc_text"
                    android:background="@drawable/bg_chip_unselected" />

            </LinearLayout>

            <!-- Technician notes (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas del técnico (opcional)"
                android:textColor="@color/lc_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etTechnicianNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="Notas adicionales del técnico..."
                android:textColor="@color/lc_text"
                android:textColorHint="@color/lc_text_tertiary"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:gravity="top" />

            <!-- Photos section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fotos de evidencia"
                    android:textColor="@color/lc_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 fotos"
                    android:textColor="@color/lc_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Photo thumbnails row -->
            <LinearLayout
                android:id="@+id/photoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- Add photo button -->
            <Button
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="+ Añadir Foto"
                android:textColor="@color/lc_primary"
                android:textSize="14sp"
                android:stateListAnimator="@null" />

            <!-- Convert to WorkItem (only visible in edit mode) -->
            <Button
                android:id="@+id/btnConvertirTrabajoDetail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="→ Convertir a Trabajo"
                android:textColor="@color/lc_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

            <View android:layout_width="match_parent" android:layout_height="8dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
