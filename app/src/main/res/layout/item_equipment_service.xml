<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvServTipo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#1B71C9"
            android:text="TIPO"/>
        <TextView android:id="@+id/tvServFecha"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#9E9E9E"
            android:text="Fecha"/>
        <TextView android:id="@+id/tvServCosto"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="12sp" android:textColor="#2E7D32"
            android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/tvServDesc"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#424242"
        android:text=""/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F0F0" android:layout_marginTop="8dp"/>
</LinearLayout>
