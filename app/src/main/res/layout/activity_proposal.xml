<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="20dp"
        android:paddingTop="14dp" android:paddingBottom="14dp">
        <ImageView android:id="@+id/btnAtras"
            android:layout_width="44dp" android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Atrás" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:text="PROPUESTA"
            android:textColor="@color/lc_text"
            android:textSize="20sp" android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <View android:id="@+id/divider"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/lc_border" />

    <LinearLayout android:id="@+id/bottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/lc_bg">
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="@color/lc_border" />
        <Button android:id="@+id/btnGuardarPropuesta"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            android:text="GUARDAR PROPUESTA"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="15sp" android:letterSpacing="0.03"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/divider" android:layout_above="@id/bottomBar"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/contentLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Template button -->
            <Button android:id="@+id/btnUsarPlantilla"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_chip_inactive"
                android:text="USAR PLANTILLA  ▾"
                android:textColor="@color/lc_text"
                android:textStyle="bold" android:textSize="13sp"
                android:letterSpacing="0.02"
                android:stateListAnimator="@null" />

            <!-- Accepted banner (hidden by default) -->
            <TextView android:id="@+id/tvAceptadaBanner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#E8F5E9"
                android:gravity="center"
                android:padding="12dp"
                android:text="&#x2713; Propuesta aceptada — solo lectura"
                android:textColor="#137333"
                android:textSize="13sp" android:textStyle="bold"
                android:visibility="gone" />

            <!-- GOOD card -->
            <include android:id="@+id/cardGood" layout="@layout/item_proposal_option" />
            <Button android:id="@+id/btnAceptarGood"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="&#x2713; Aceptar Good"
                android:textColor="#137333"
                android:textStyle="bold" android:textSize="13sp"
                android:stateListAnimator="@null" />
            <!-- BETTER card -->
            <include android:id="@+id/cardBetter" layout="@layout/item_proposal_option"
                android:layout_marginTop="16dp" />
            <Button android:id="@+id/btnAceptarBetter"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="&#x2713; Aceptar Better"
                android:textColor="#1B71C9"
                android:textStyle="bold" android:textSize="13sp"
                android:stateListAnimator="@null" />
            <!-- BEST card -->
            <include android:id="@+id/cardBest" layout="@layout/item_proposal_option"
                android:layout_marginTop="16dp" />
            <Button android:id="@+id/btnAceptarBest"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="&#x2713; Aceptar Best"
                android:textColor="#F57C00"
                android:textStyle="bold" android:textSize="13sp"
                android:stateListAnimator="@null" />

            <View android:layout_width="match_parent" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
