<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_surface"
    android:layout_marginTop="8dp">

    <!-- Row 1: severity badge + area/component -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSeverityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="MEDIO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/lc_text_secondary"
            android:background="@drawable/bg_chip_unselected"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAreaComponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lc_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="OPEN"
            android:textSize="10sp"
            android:textColor="@color/lc_text_secondary"
            android:background="@drawable/bg_chip_unselected" />
    </LinearLayout>

    <!-- Row 2: problem (1 line) -->
    <TextView
        android:id="@+id/tvProblem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/lc_text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Row 3: convert button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btnConvertirWorkItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="→ Crear Trabajo"
            android:textColor="@color/lc_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_unselected" />

    </LinearLayout>

</LinearLayout>
