<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Atrás" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="REPORTES"
            android:textColor="@color/lc_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/lc_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Sección: Historial por cliente -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HISTORIAL POR CLIENTE"
                android:textColor="@color/lc_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/llClientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lc_border"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Sección: Equipos por marca -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EQUIPOS POR MARCA"
                android:textColor="@color/lc_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/llMarcas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lc_border"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Sección: Exportar -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPORTAR"
                android:textColor="@color/lc_text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/btnExportarRepuestos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar Repuestos CSV"
                android:textColor="@color/lc_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_surface"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/btnExportarEquipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar Equipos CSV"
                android:textColor="@color/lc_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_surface" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
