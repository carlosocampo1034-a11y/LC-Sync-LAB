<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Atrás" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Perfil"
            android:textColor="@color/lc_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/lc_border" />

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_marginBottom="56dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar + nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar_rojo_suave"
                    android:gravity="center"
                    android:text="Q"
                    android:textColor="#E91605"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:contentDescription="Foto de perfil" />

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/lc_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/lc_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:textColor="@color/lc_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Estadísticas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_surface">

                    <TextView
                        android:id="@+id/statHoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/lc_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Trabajos"
                        android:textColor="@color/lc_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_surface">

                    <TextView
                        android:id="@+id/statSemana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/lc_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Completados"
                        android:textColor="@color/lc_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_surface">

                    <TextView
                        android:id="@+id/statCompletados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/lc_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="En curso"
                        android:textColor="@color/lc_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider antes del menú -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/lc_surface" />

            <!-- Header menú -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:text="MENÚ"
                android:textColor="@color/lc_text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Items del menú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <include layout="@layout/item_menu"
                    android:id="@+id/menuDatos" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuCompletados" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuRepuestos" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuEquipos" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuEstadisticas" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuReportes" />
                <View android:id="@+id/dividerReportes" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuAuditoria" />
                <View android:id="@+id/dividerAuditoria" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuFavoritos" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuConfiguracion" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuAyuda" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuDispatch" />
                <View android:id="@+id/dividerDispatch" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuPagos" />
                <View android:id="@+id/dividerPagos" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuTecnicos" />
                <View android:id="@+id/dividerTecnicos" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lc_border" />

                <include layout="@layout/item_menu"
                    android:id="@+id/menuCerrarSesion" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="120dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
