<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO variante de laboratorio (debug / com.lc.technician.dev). La release y la app original no usan este archivo.
     - Por defecto: sin HTTP en claro; certificados del sistema para cualquier otro destino.
     - 127.0.0.1: HTTPS obligatorio con CA de laboratorio (cert tiene SAN para 127.0.0.1).
     - 10.0.0.121 (Wi-Fi del laboratorio): HTTPS obligatorio y SOLO la CA de laboratorio. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/lab_ca" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.0.0.121</domain>
        <trust-anchors>
            <certificates src="@raw/lab_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
